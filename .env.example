# Copy this file to .env and fill in your own Supabase project's values.
# Without these, the app still works fully — saved old machines just stay
# in the browser's localStorage instead of syncing to the cloud.
#
# Find these in your Supabase project: Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: shown as a "View source on GitHub" link in the footer once you've
# pushed this repo, e.g. https://github.com/your-username/washing-machine-navi
VITE_GITHUB_REPO_URL=
